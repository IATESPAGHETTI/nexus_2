# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# DeepSeek is the default production provider (provider/model default to these values).
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# NEXUS_LLM_PROVIDER=deepseek
# NEXUS_LLM_MODEL=deepseek-chat

# Groq GPT-OSS 120B (still supported; opt-in by setting NEXUS_LLM_PROVIDER=groq).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# NEXUS_LLM_PROVIDER=groq
# NEXUS_LLM_MODEL=openai/gpt-oss-120b

# Gemini (development-only override).
# NEXUS_LLM_PROVIDER=gemini
# NEXUS_LLM_MODEL=gemini-3.5-flash-lite   (free tier; gemini-3.8-flash is limited to 5 requests/min, too few for a multi-agent run)
# GEMINI_API_KEY=your_gemini_api_key_here

# Seconds the orchestrator waits for a human to approve a recovery plan (default 600).
# MAX_APPROVAL_WAIT_SECONDS=600
# Investigation rounds before NEXUS abstains; each round makes several paid model calls (default 3).
# MAX_REEVALUATION_LOOPS=3

# Per-incident spending limits (orchestrator/budget.py). When one is reached the investigation
# stops calling the model and ABSTAINS. Defaults are conservative guesses, not measured values.
# MAX_LLM_CALLS_PER_INCIDENT=60
# MAX_TOTAL_TOKENS_PER_INCIDENT=250000
# MAX_TOKENS_PER_AGENT=80000

# Where the backend stores incidents (default backend/.data/nexus.db; ":memory:" = not persisted).
# NEXUS_DB_PATH=

# Optional: require this token to approve/reject a recovery (blocks direct calls to the backend;
# the dashboard dev server adds it server-side if the same variable is set where it starts).
# NEXUS_APPROVER_TOKEN=

# Incident Manager triage: 1 (default) = call only the agents the symptom points at; 0 = always call all four
# NEXUS_TRIAGE=1

# ---- Platform / cloud deployment (docker compose; see deploy/DEPLOY.md) ----
# Basic-auth login for the dashboard. LEAVE PASSWORD EMPTY ONLY FOR LOCAL USE.
# DASHBOARD_USER=nexus
# DASHBOARD_PASSWORD=
# NEXUS_APPROVER_TOKEN=            (nginx adds it to approval calls)
# NEXUS_INTERNAL_TOKEN=            (backend <-> orchestrator shared secret)
# CRITIC_URL=http://critic:8106    (http://crewai-critic:8106 with --profile crewai)

# ---- Experiment switches ----
# NEXUS_TOPOLOGY=hub               (hub | blackboard)
# NEXUS_PROMPT_VARIANT=default     (default | react | fewshot | persona_sre | persona_auditor)
# NEXUS_GUARDRAILS=1               (0 disables input/tool-output guardrails, for A/B runs only)
# NEXUS_CRITIC_FRAMEWORK=adk       (adk | crewai)
# NEXUS_EVIDENCE_FRAMEWORK=adk     (adk | crewai)
# NEXUS_ENABLE_ANALYSIS_TOOLS=0    (1 = second MCP server: runbook parser, calculator, latency statistics)
# NEXUS_ENABLE_WEB_SEARCH=0         (1 = let the Logs and Change agents search the public web; the query leaves your machine)
